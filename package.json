{
  "name": "ops-board",
  "private": true,
  "version": "0.0.0",
  "description": "OpsBoard — voice-first, read-only personal mission planner with dependency-aware task orchestration",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "design:extract": "bash scripts/extract-design.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0",
      "better-auth": "~1.4.18",
      "brace-expansion@<1.1.17": ">=1.1.17 <2.0.0",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3 <3.0.0",
      "brace-expansion@>=3.0.0 <5.0.8": ">=5.0.8",
      "fast-uri@<3.1.4": ">=3.1.4 <4.0.0",
      "form-data": "^4.0.6",
      "hono": ">=4.12.25",
      "postcss": "^8.5.18",
      "sharp@<0.35.0": ">=0.35.0",
      "undici": "^7.28.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gv7w-rqvm-qjhr",
        "GHSA-pw9m-5jxm-xr6h",
        "GHSA-392p-2q2v-4372",
        "GHSA-7w99-5wm4-3g79",
        "GHSA-86j7-9j95-vpqj",
        "GHSA-9h47-pqcx-hjr4",
        "GHSA-fmh4-wcc4-5jm3",
        "GHSA-g38m-r43w-p2q7",
        "GHSA-qq9h-g4jm-xgf3"
      ]
    }
  }
}
